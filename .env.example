# Port HTTP local de WordPress
WORDPRESS_PORT=8082

# Acces a la base de donnees locale
WORDPRESS_DB_NAME=stlg
WORDPRESS_DB_USER=stlg
WORDPRESS_DB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me

# Compte administrateur cree lors de l'installation locale initiale
WORDPRESS_ADMIN_USER=stlg_admin
WORDPRESS_ADMIN_PASSWORD=change-me
WORDPRESS_ADMIN_EMAIL=admin@example.test
